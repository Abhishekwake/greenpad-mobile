{
  "name": "greenpad-workspace",
  "private": true,
  "description": "GreenPad — Expo mobile app, Next.js admin, Express API",
  "scripts": {
    "mobile": "npm run start --prefix mobile-app",
    "mobile:android": "npm run android --prefix mobile-app",
    "mobile:ios": "npm run ios --prefix mobile-app",
    "mobile:web": "npm run web --prefix mobile-app",
    "admin": "npm run dev --prefix greenpad-admin",
    "admin:build": "npm run build --prefix greenpad-admin",
    "api": "npm run dev --prefix backend",
    "api:start": "npm start --prefix backend"
  },
  "dependencies": {
    "greenpad-admin": "file:greenpad-admin"
  }
}
