# Copy to `.env` only when you need a manual override.
#
# Dev (Expo Go on a physical phone): usually leave unset — the app reads the Metro
# host (same IP as the QR code, e.g. exp://192.168.0.153:8081) and calls port 5000.
#
# Manual override (if auto-detect fails):
#   EXPO_PUBLIC_API_URL=http://192.168.0.153:5000/api
#
# Production build (overrides app.json when set):
#   EXPO_PUBLIC_API_URL=https://greenpad-mobile.onrender.com/api
