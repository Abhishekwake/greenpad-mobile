# Copy to `.env` when you need to override `app.json` → `expo.extra.apiBaseUrl`.
# Example local backend:
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api
# Production (same as app.json default) — only set if you do not want app.json value:
#   EXPO_PUBLIC_API_URL=https://greenpad-mobile.onrender.com/api
