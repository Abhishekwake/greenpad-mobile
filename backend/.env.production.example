# Production — copy to `.env.production` on the server (do not commit secrets).
# Used when NODE_ENV=production (e.g. `npm start`).

NODE_ENV=production
PORT=5000

MONGODB_URI=mongodb+srv://user:pass@cluster.example/greenpad
JWT_SECRET=use_a_long_random_string
JWT_EXPIRE=30d

# CORS: comma-separated admin + app origins (no spaces). Do not use * in production if you use credentials.
CORS_ORIGIN=https://admin.yourdomain.com,https://app.yourdomain.com

ADMIN_EMAIL=admin@greenpad.com
# Required in production — generate with: node scripts/generateAdminPasswordHash.js
ADMIN_PASSWORD_HASH=
ADMIN_SEED_PHONE=9000000001

# Optional: max POST /api/auth/send-otp per IP per minute (default 15).
# OTP_RATE_LIMIT_MAX=30

# Temporary only: return OTP in send-otp JSON for app testing (no real SMS yet). Remove when live.
# EXPOSE_OTP_IN_RESPONSE=true

# Optional: Cloudinary, SMS, etc.
