# Development — copy to `.env` in this folder (`backend/.env`).
# Loaded when NODE_ENV is not `production` (e.g. `npm run dev`).

PORT=5000
MONGODB_URI=mongodb://localhost:27017/greenpad
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=30d
NODE_ENV=development

# CORS: comma-separated origins, or * for any (dev only). Production: list your admin + app URLs.
# Example: https://admin.yourdomain.com,https://app.yourdomain.com
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# MongoDB (local or Atlas — use full SRV string from Atlas UI for production)
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/greenpad?retryWrites=true&w=majority

# Production / Render testing: include OTP in send-otp JSON (disable after real SMS).
# EXPOSE_OTP_IN_RESPONSE=true

# Admin dashboard login (POST /api/auth/admin-login)
ADMIN_EMAIL=admin@greenpad.com
# Production: set bcrypt hash (run: node scripts/generateAdminPasswordHash.js yourPassword)
# ADMIN_PASSWORD_HASH=
# Dev only — plain password fallback when ADMIN_PASSWORD_HASH is unset
ADMIN_PASSWORD=admin123
# Phone used only when auto-creating the first admin user (10 digits, must be unique)
ADMIN_SEED_PHONE=9000000001

# Per-user rate limits (mobile app)
# LEAD_CREATE_RATE_WINDOW_MS=3600000
# LEAD_CREATE_RATE_MAX=5
# REDEEM_RATE_WINDOW_MS=3600000
# REDEEM_RATE_MAX=3

# Daily coin reconciliation cron (super_admin can also run manually)
# ENABLE_RECONCILE_CRON=true
# RECONCILE_CRON_SCHEDULE=0 3 * * *
