# Admin (Next.js) — API base URL
#
# `next dev` loads committed `.env.development` (same key). Override with `.env.local` if needed.
# Production: use `.env.production` or host env (see `.env.production.example`).

# Must include /api (or the app will append it automatically)
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000/api
